{
    "name": "kongpda/laravel-attachments-core",
    "description": "Backend foundation for reusable Laravel attachments with private R2/S3-friendly storage.",
    "keywords": [
        "kongpda",
        "laravel",
        "attachments",
        "storage"
    ],
    "homepage": "https://github.com/kongpda/laravel-attachments-core",
    "license": "MIT",
    "authors": [
        {
            "name": "kongpda",
            "email": "kongpda@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-gd": "*",
        "spatie/laravel-package-tools": "^1.93.1",
        "illuminate/auth": "^12.60|^13.10",
        "illuminate/contracts": "^12.60|^13.10",
        "illuminate/database": "^12.60|^13.10",
        "illuminate/filesystem": "^12.60|^13.10",
        "illuminate/http": "^12.60|^13.10",
        "illuminate/queue": "^12.60|^13.10",
        "illuminate/routing": "^12.60|^13.10",
        "illuminate/support": "^12.60|^13.10",
        "intervention/image-laravel": "^1.5.9"
    },
    "suggest": {
        "ext-imagick": "Required for PDF thumbnail generation (used by spatie/pdf-to-image).",
        "spatie/pdf-to-image": "Enables PDF thumbnail generation when attachments.thumbnails.pdf_enabled is true (^3.2)."
    },
    "require-dev": {
        "laravel/pint": "^1.29.1",
        "larastan/larastan": "^3.10",
        "nunomaduro/collision": "^8.9.4",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^4.7.2",
        "pestphp/pest-plugin-arch": "^4.0.2",
        "pestphp/pest-plugin-laravel": "^4.1",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan-deprecation-rules": "^2.0.4",
        "phpstan/phpstan-phpunit": "^2.0.16",
        "spatie/pdf-to-image": "^3.2"
    },
    "autoload": {
        "psr-4": {
            "Kongpda\\LaravelAttachments\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kongpda\\LaravelAttachments\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Kongpda\\LaravelAttachments\\Providers\\AttachmentCoreServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
